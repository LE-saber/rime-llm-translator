[Unit]
Description=Rime offline translation worker
Wants=rime-llm-ai.service

[Service]
Type=simple
ExecStart=/usr/bin/rime-llm-translator serve
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
Nice=10
CPUQuota=100%
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
