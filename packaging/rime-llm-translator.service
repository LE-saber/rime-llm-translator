[Unit]
Description=Rime offline translation worker
Wants=rime-llm-ai.service

[Service]
Type=simple
ExecStart=/usr/bin/rime-llm-translator serve
Environment=ARGOS_DEVICE_TYPE=cpu
Environment=ARGOS_INTER_THREADS=1
Environment=ARGOS_INTRA_THREADS=2
Environment=OMP_NUM_THREADS=2
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=default.target
